    {"id":"s01","type":"rubric","text":"Deinde osculatur altare: et elevatis oculis, extendens, elevans, et iungens manus, caputque cruci inclinans, dicit:","an":8},
    {"id":"s02","type":"verse","speaker":"sacerdos","voice":"clara","w":[{"i":"w001","f":"Benedícat","l":"benedico","m":257},{"i":"w002","f":"vos","l":"vos","m":49},{"i":"w003","f":"omnípotens","l":"omnipotens","m":59,"h":"w004"},{"i":"w004","f":"Deus","l":"deus","p":",","m":60}]},
    {"id":"s03","type":"rubric","text":"et versus ad populum, semel tantum benedicens, etiam in Missis solemnibus, prosequitur:","an":8},
