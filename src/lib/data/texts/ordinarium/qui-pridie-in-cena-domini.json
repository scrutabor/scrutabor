    {"id":"s02","type":"rubric","text":"Accipit hostiam."},
    {"id":"s03","type":"verse","speaker":"sacerdos","voice":"secreto","w":[{"i":"w012","f":"accépit","l":"accipio","m":195},{"i":"w013","f":"panem","l":"panis","m":162},{"i":"w014","f":"in","l":"in","m":3,"h":"w018"},{"i":"w015","f":"sanctas","l":"sanctus","m":180,"h":"w018"},{"i":"w016","f":"ac","l":"ac","m":15},{"i":"w017","f":"venerábiles","l":"venerabilis","m":180,"h":"w018"},{"i":"w018","f":"manus","l":"manus","m":314},{"i":"w019","f":"suas","l":"suus","p":",","m":180,"h":"w018"}]},
    {"id":"s04","type":"rubric","text":"Elevat oculos ad cælum."},
    {"id":"s05","type":"verse","speaker":"sacerdos","voice":"secreto","w":[{"i":"w020","f":"et","l":"et","m":15},{"i":"w021","f":"elevátis","l":"elevo","m":340,"h":"w022"},{"i":"w022","f":"óculis","l":"oculus","m":51},{"i":"w023","f":"in","l":"in","m":3,"h":"w024"},{"i":"w024","f":"cælum","l":"caelum","m":82},{"i":"w025","f":"ad","l":"ad","m":3,"h":"w026"},{"i":"w026","f":"te","l":"tu","m":4},{"i":"w027","f":"Deum","l":"deus","p":",","m":35},{"i":"w028","f":"Patrem","l":"pater","m":162},{"i":"w029","f":"suum","l":"suus","m":96,"h":"w028"},{"i":"w030","f":"omnipoténtem","l":"omnipotens","p":",","m":96,"h":"w028"}]},
    {"id":"s06","type":"rubric","text":"Caput inclinat."},
    {"id":"s07","type":"verse","speaker":"sacerdos","voice":"secreto","w":[{"i":"w031","f":"tibi","l":"tu","m":139},{"i":"w032","f":"grátias","l":"gratia","m":169},{"i":"w033","f":"agens","l":"ago","p":",","m":231,"h":"w001"}]},
    {"id":"s08","type":"rubric","text":"Signat super hostiam."},
    {"id":"s09","type":"verse","speaker":"sacerdos","voice":"secreto","w":[{"i":"w034","f":"benedíxit","l":"benedico","p":",","m":195},{"i":"w035","f":"fregit","l":"frango","p":",","m":195},{"i":"w036","f":"dedítque","l":"do","m":28},{"i":"w037","f":"discípulis","l":"discipulus","m":267},{"i":"w038","f":"suis","l":"suus","p":",","m":236,"h":"w037"},{"i":"w039","f":"dicens","l":"dico","p":":","m":231,"h":"w001"}]},
    {"id":"s10","type":"verse","speaker":"sacerdos","voice":"secreto","w":[{"i":"w040","f":"Accípite","l":"accipio","p":",","m":155},{"i":"w041","f":"et","l":"et","m":15},{"i":"w042","f":"manducáte","l":"manduco","m":158},{"i":"w043","f":"ex","l":"ex","m":0,"h":"w044"},{"i":"w044","f":"hoc","l":"hic","m":116},{"i":"w045","f":"omnes","l":"omnis","p":".","m":87,"h":"w042"}]},
    {"id":"s11","type":"rubric","text":"Tenens ambabus manibus hostiam inter indices et pollices, profert verba consecrationis distincte et attente super hostiam, et simul super omnes, si plures sint consecrandæ."},
    {"id":"s12","type":"verse","speaker":"sacerdos","voice":"secreto","w":[{"i":"w046","f":"Hoc","l":"hic","m":288},{"i":"w047","f":"est","l":"sum","m":21},{"i":"w048","f":"enim","l":"enim","m":15},{"i":"w049","f":"Corpus","l":"corpus","m":97},{"i":"w050","f":"meum","l":"meus","p":".","m":105,"h":"w049"}]},
    {"id":"s13","type":"rubric","text":"Quibus verbis prolatis, statim hostiam consecratam genuflexus adorat: surgit, ostendit populo, reponit super corporale, et genuflexus iterum adorat: nec amplius pollices et indices disiungit, nisi quando hostia tractanda est, usque ad ablutionem digitorum."}
  ]
