     "id": "use.en.650665a2027b4ea8c645",
     "address": {
      "kind": "segment",
      "segment": "s13"
     },
     "claim": "Pour forth, we beseech thee, O Lord, thy grace into our hearts; that we, to whom the Incarnation of Christ, thy Son, was made known by the message of an angel, may by his Passion and Cross be brought to the glory of his Resurrection. Through the same Christ, our Lord. Amen."
