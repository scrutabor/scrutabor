019":"Zgadza się z „Sanctis” (w020).","w022":"Celownik liczby mnogiej, ostatnie dopełnienie „Confíteor” (w001).","w023":"Wołacz liczby mnogiej użyty w bezpośrednim zwrocie."},"en":{"w001":"Governs the chain of datives that follows.","w002":"Dative, the first complement of “Confíteor” (w001).","w003":"Agrees with “Deo” (w002).","w004":"Agrees with “Maríæ” (w005).","w006":"Together with “Vírgini” (w007), forms the title “ever Virgin”.","w007":"The title in apposition to “Maríæ” (w005).","w008":"Agrees with the name that follows, “Michaéli” (w009).","w010":"Dative in apposition to “Michaéli” (w009).","w011":"Agrees with the following “Ioánni” (w012).","w013":"Apposition to “Ioánni” (w012).","w014":"Agrees with “Apóstolis” (w015).","w016":"Together with “Paulo” (w018), in apposition to “Apóstolis” (w015).","w018":"Apposition to “Apóstolis” (w015).","w019":"Agrees with “Sanctis” (w020).","w022":"Dative plural, the final complement of “Confíteor” (w001).","w023":"Vocative plural used in direct address."}}},{"id":"s03","type":"verse","voice":"clara","speaker":"sacerdos","w":[{"i":"w024","f":"quia","l":"quia","m":15},{"i":"w025","f":"peccávi","l":"pecco","m":2},{"i":"w026","f":"nimis","l":"nimis","m":32},{"i":"w027","f":"cogitatióne","l":"cogitatio","p":",","m":45},{"i":"w028","f":"verbo","l":"verbum","m":26},{"i":"w029","f":"et","l":"et","m":15},{"i":"w030","f":"ópere","l":"opus","p":":","m":135}],"tr":{"pl":"że bardzo zgrzeszyłem myślą, mową i uczynkiem:","en":"that I have sinned exceedingly in thought, word and deed:"},"tc":{"pl":[142],"en":[143]},"g":{"pl":["że","zgrzeszyłem","bardzo","myślą","mową","i","uczynkiem"],"en":["that","I have sinned","exceedingly","in thought","in word","and","in deed"]},"fn":{"pl":{"w024":"Wprowadza zdanie „quia peccávi”, które wskazuje treść wyznania.","w027":"Pierwszy z trzech ablativów narzędzia: myślą, mową i uczynkiem."},"en":{"w024":"Introduces the clause “quia peccávi”, which states what is confessed.","w027":"The first of three ablatives of means: by thought, word, and deed."}}},{"id":"s04","type":"rubric","text":"Percutit sibi pectus ter, dicens:","an":8,"nr":{"pl":"Kapłan trzykrotnie uderza się w piersi.","en":"The priest strikes his breast three times."},"nc":{"pl":[144],"en":[144]}},{"id":"s05","type":"verse","voice":"clara","speaker":"sacerdos","w":[{"i":"w031","f":"mea","l":"meus","m":31,"h":"w032"},{"i":"w032","f":"culpa","l":"culpa","p":",","m":30},{"i":"w033","f":"mea","l":"meus","m":31,"h":"w034"},{"i":"w034","f":"culpa","l":"culpa","p":",","m":30},{"i":"w035","f":"mea","l":"meus","m":31,"h":"w037"},{"i":"w036","f":"máxima","l":"magnus","m":248,"h":"w037"},{"i":"w037","f":"culpa","l":"culpa","p":".","m":30}],"tr":{"pl":"moja wina, moja wina, moja bardzo wielka wina.","en":"through my fault, through my fault, through my most grievous fault."},"tc":{"pl":[142],"en":[143]},"g":{"pl":["moją","winą","moją","winą","moją","największą","winą"],"en":["my","fault","my","fault","my","greatest","fault"]},"fn":{"pl":{"w031":"Zgadza się z „culpa” (w032).","w032":"Ablativus przyczyny: „z mojej winy”.","w036":"Zgadza się z „culpa” (w037)."},"en":{"w031":"Agrees with “culpa” (w032).","w032":"Ablative of cause: “through my fault”.","w036":"Agrees with “culpa” (w037)."}}},{"id":"s06","type":"verse","speaker":"sacerdos","voice":"clara","w":[{"i":"w038","f":"Ídeo","l":"ideo","m":32},{"i":"w039","f":"precor","l":"precor","m":249},{"i":"w040","f":"beátam","l":"beatus","m":8,"h":"w041"},{"i":"w041","f":"Maríam","l":"Maria","m":141},{"i":"w042","f":"semper","l":"semper","m":32},{"i":"w043","f":"Vírginem","l":"virgo","p":",","m":7},{"i":"w044","f":"beátum","l":"beatus","m":96,"h":"w045"},{"i":"w045","f":"Michaélem","l":"Michael","m":162,"a":0},{"i":"w046","f":"Archángelum","l":"archangelus","p":",","m":35},{"i":"w047","f":"beátum","l":"beatus","m":96,"h":"w048"},{"i":"w048","f":"Ioánnem","l":"Ioannes","m":162},{"i":"w049","f":"Baptístam","l":"Baptista","p":",","m":224},{"i":"w050","f":"sanctos","l":"sanctus","