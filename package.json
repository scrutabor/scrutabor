{
	"name": "scrutabor",
	"private": true,
	"version": "0.10.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && stylelint \"src/**/*.{css,svelte}\"",
		"lint:clones": "jscpd src",
		"test:unit": "vitest run",
		"test:font-subsets": "node scripts/check-font-subsets.mjs",
		"test:e2e": "playwright test",
		"test": "npm run test:font-subsets && npm run test:unit && npm run test:e2e",
		"build:offline-runtime": "vite build --config vite.offline.config.ts",
		"build:offline": "npm run build && npm run build:offline-runtime && node scripts/build-offline.mjs"
	},
	"overrides": {
		"cookie": "^0.7.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"apca-w3": "^0.1.9",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"jscpd": "5.0.14",
		"pdf-lib": "^1.17.1",
		"postcss-html": "^2.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"stylelint": "^17.14.1",
		"stylelint-config-recommended": "^18.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	}
}
