# Served by Cloudflare Pages as response headers (build output includes this
# file from static/).
#
# Everything under /_app/immutable/ is content-hashed by the build — a changed
# file is a changed URL — so a year of immutable is the correct cache policy.
# Without it the default four-hour must-revalidate had every repeat visitor
# paying a conditional round-trip per asset.
/_app/immutable/*
	Cache-Control: public, max-age=31536000, immutable

# The worker is the version switch for the offline book. Its own update check
# must always reach the deployed release; the pages and hashed assets it owns
# remain cached according to their separate policies.
/service-worker.js
	Cache-Control: no-cache, no-store, must-revalidate

# HSTS: the http:// request already 301s to https, but without this header
# the FIRST request of every new visitor is unprotected. www is the only
# subdomain and serves this same project over https.
/*
	Strict-Transport-Security: max-age=31536000; includeSubDomains
